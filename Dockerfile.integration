FROM node:22.17.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ARG VITE_FIREBASE_API_KEY=integration-fake-key
ARG VITE_FIREBASE_AUTH_DOMAIN=astryxforge-integration.local
ARG VITE_FIREBASE_PROJECT_ID=astryxforge-integration
ARG VITE_FIREBASE_STORAGE_BUCKET=astryxforge-integration.appspot.com
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
ARG VITE_FIREBASE_APP_ID=1:000000000000:web:integration
ARG VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
ARG VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
ARG VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
ARG VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID \
    VITE_FIREBASE_EMULATOR_HOST=$VITE_FIREBASE_EMULATOR_HOST \
    VITE_FIREBASE_AUTH_EMULATOR_PORT=$VITE_FIREBASE_AUTH_EMULATOR_PORT \
    VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=$VITE_FIREBASE_FIRESTORE_EMULATOR_PORT \
    VITE_FIREBASE_STORAGE_EMULATOR_PORT=$VITE_FIREBASE_STORAGE_EMULATOR_PORT
RUN npm run build && node integration/assert-emulator-build.mjs

FROM node:22.17.0-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=integration HOST=0.0.0.0 PORT=3000
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/runtime/server.js ./runtime/server.js
COPY --from=build /app/api/admin ./api/admin
COPY --from=build /app/src/server/admin ./src/server/admin
EXPOSE 3000
CMD ["node", "runtime/server.js"]
