# Echo AI Integration
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real keys.

# Base URL for the Echo AI service.
# Local dev:    http://localhost:7860  or  https://echo.home
# Production:   https://<machine>.<tailnet>.ts.net  (Tailscale Funnel URL)
ECHO_URL=

# API key sent as X-Echo-Api-Key on every Echo request.
# Required in production. Echo must validate this key server-side.
# Generate with: openssl rand -hex 32
ECHO_API_KEY=

# Ollama model to use (default: qwen3:14b — change only if you switch models).
# ECHO_MODEL=qwen3:14b
